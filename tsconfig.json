{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "paths": {
      "@core/*": ["./packages/graph-core/src/*"],
      "@gv/*": ["./packages/graph-vue/src/*"],
      "@content/*": ["./packages/content/*"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.vue", ".vitepress/**/*.ts", ".vitepress/**/*.mts", ".vitepress/**/*.vue", "scripts/**/*.ts"]
}
